# Public Supabase project configuration. These values are safe for browser use
# when Row Level Security is enabled. Never add a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Telegram configuration. Never prefix these with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
TELEGRAM_CHAT_ID=replace-with-your-chat-id

# Server-only scheduled monitor configuration. Leave values blank in this template.
SUPABASE_SECRET_KEY=
CRON_SECRET=
TCG_RADAR_OWNER_USER_ID=
